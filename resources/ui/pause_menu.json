{
  "_comment": "Data-driven pause overlay (docs/HudSystem.md §11a). Loaded by UI::loadPauseMenuInto into pause:<panel> UISystem screens; replaces the ImGui renderPauseMenu. 1280x720 virtual canvas, scaled to the window. Button action types: resume / open_settings / main_menu / quit_game.",
  "background_type": "solid",
  "background_color": [0.03, 0.03, 0.06, 0.88],
  "start_panel": "main",
  "panels": {
    "main": {
      "children": [
        { "type": "label",  "id": "pause_title", "text": "PAUSED", "font": "title", "position": [640, 170], "size": [400, 70] },
        { "type": "button", "id": "pause_resume",   "text": "Resume",    "position": [540, 300], "size": [200, 48], "action": { "type": "resume" } },
        { "type": "button", "id": "pause_settings", "text": "Settings",  "position": [540, 360], "size": [200, 48], "action": { "type": "open_settings" } },
        { "type": "button", "id": "pause_mainmenu", "text": "Main Menu", "position": [540, 420], "size": [200, 48], "action": { "type": "main_menu" } },
        { "type": "button", "id": "pause_quit",     "text": "Quit",      "position": [540, 480], "size": [200, 48], "action": { "type": "quit_game" } }
      ]
    }
  }
}
