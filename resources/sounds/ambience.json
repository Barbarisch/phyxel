        { "event": "amb.bird.crow", "interval": [30, 70], "when": "day", "radius": [15, 35], "yOffset": [5, 20] }
      ]
    },
    "Tundra": {
      "bed": "ambience/tundra_bed.wav",
      "scatter": [
        { "event": "amb.bird.crow", "interval": [25, 60], "when": "day",    "radius": [15, 35], "yOffset": [5, 20] },
        { "event": "amb.wind.gust", "interval": [10, 22], "when": "always", "radius": [15, 30], "yOffset": [2, 10] }
      ]
