{
  "name": "forge_dragon_turtle",
  "_template": "Dragon turtle archetype (shelled). A vast domed carapace over a squat four-flipper body, with a draconic neck and head out the front and a spiked tail out the back. The shell is a SWEPT VOLUME on a short two-joint chain running nose-to-tail with a very wide, very shallow profile - a dome is just a tube whose radius dwarfs its length, so no new primitive is needed. Neutral sea-slate palette FOR tinting.",
  "palette": {
    "shell": { "color": "#6b7268", "rough": 0.92 },
    "plastron": { "color": "#a8a894", "rough": 0.9 },
    "hide_body": { "color": "#6f7a6e", "rough": 0.9 },
    "hide_neck": { "color": "#75806f", "rough": 0.9 },
    "hide_limb": { "color": "#6c7668", "rough": 0.9 },
    "hide_tail": { "color": "#68715f", "rough": 0.9 },
    "horn": { "color": "#c8c2a8", "rough": 0.4 },
    "claw": { "color": "#39392f", "rough": 0.55 },
    "eye": { "color": "#20a0b8", "rough": 0.2 }
  },
  "shading": {
    "_note": "Engine lights character parts with high contrast (open gap) - keep the ramp gentle.",
    "gradient": { "top": 0.14, "bottom": -0.2 },
    "noise": { "size": 0.022, "amount": 0.1 }
  },
  "smooth_angle": 55,
  "joints": {
    "Pelvis": [0, 0.34, -0.28],
    "Rump": { "from": "Pelvis", "up": -0.02, "fwd": -0.13 },
    "Spine": { "from": "Pelvis", "up": 0.02, "fwd": 0.3 },
    "Chest": { "from": "Spine", "up": 0.0, "fwd": 0.22 },

    "_note_shell": "The carapace rides ABOVE the body chain on its own two-joint spine so the dome's own axis is horizontal - swept along the body chain instead, its shallow profile would have been read as a flattened barrel and swallowed the neck root.",
    "ShellBack": { "from": "Pelvis", "up": 0.16, "fwd": -0.06 },
    "ShellFront": { "from": "ShellBack", "fwd": 0.44 },

    "NeckA": { "from": "Chest", "up": 0.08, "fwd": 0.16 },
    "NeckB": { "from": "NeckA", "up": 0.11, "fwd": 0.14 },
    "HeadRoot": { "from": "NeckB", "up": 0.04, "fwd": 0.09 },
    "Skull": { "from": "HeadRoot", "up": 0.02, "fwd": 0.11 },
    "Brow": { "from": "Skull", "up": 0.0, "fwd": 0.07 },
    "Muzzle": { "from": "Brow", "up": -0.025, "fwd": 0.12 },
    "NoseTip": { "from": "Muzzle", "up": -0.015, "fwd": 0.07 },

    "TailRoot": { "from": "Pelvis", "up": 0.01, "fwd": -0.12 },
    "Tail1": { "from": "TailRoot", "up": -0.02, "fwd": -0.2 },
    "Tail2": { "from": "Tail1", "up": -0.02, "fwd": -0.15 },
    "TailTip": { "from": "Tail2", "up": -0.01, "fwd": -0.19 },

    "_note_flippers": "Flippers, not legs: a broad flat paddle instead of a paw, angled down and out. The body plan still calls the terminals legs because grounding needs a support polygon.",
    "LFrontRoot": { "from": "Chest", "side": 0.16, "up": -0.02, "fwd": 0.0 },
    "LFrontMid": { "from": "LFrontRoot", "side": 0.13, "up": -0.11, "fwd": 0.04 },
    "LFrontPaw": { "from": "LFrontMid", "side": 0.05, "fwd": 0.05, "ground": 0.02 },

    "LBackRoot": { "from": "Pelvis", "side": 0.15, "up": -0.02, "fwd": 0.0 },
    "LBackMid": { "from": "LBackRoot", "side": 0.12, "up": -0.14, "fwd": -0.02 },
    "LBackPaw": { "from": "LBackMid", "side": 0.04, "fwd": 0.04, "ground": 0.02 }
  },
  "chains": {
    "body": ["Rump", "Pelvis", "Spine", "Chest"],
    "shell": ["ShellBack", "ShellFront"],
    "neck": ["NeckA", "NeckB", "HeadRoot", "Skull", "Brow", "Muzzle", "NoseTip"],
    "tail": ["TailRoot", "Tail1", "Tail2", "TailTip"],
    "LFront": ["LFrontRoot", "LFrontMid", "LFrontPaw"],
    "LBack": ["LBackRoot", "LBackMid", "LBackPaw"]
  },
  "attach": {
