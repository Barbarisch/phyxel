    "claw": { "color": "#3c382f", "rough": 0.55 },
    "eye": { "color": "#c03018", "rough": 0.2 }
  },
  "shading": {
    "_note": "Engine lights character parts with high contrast (open gap) - keep the ramp gentle.",
    "gradient": { "top": 0.13, "bottom": -0.22 },
    "noise": { "size": 0.016, "amount": 0.11 }
  },
  "smooth_angle": 50,
  "joints": {
    "_note_balance": "Pelvis, LBack* and the foot offsets are the theropod's numbers, with the shin lengthened (hock -0.15 -> -0.19) to break a 50:50 segment rhythm; the foot is ground-pinned and the pelvis is absolute, so that only deepens the crouch. Balance is re-checked on every build, not assumed. The tarrasque's extra mass goes into the barrel and tail, which sit fore and aft of the hips respectively - adding it to the chest alone would push the centroid past the toes and the balance gate would (correctly) refuse.",

