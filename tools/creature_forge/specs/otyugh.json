{
  "name": "forge_otyugh",
  "_template": "Otyugh archetype (tentacled). A bloated refuse-eating sac on THREE stubby legs, with two long grasping tentacles ending in bark-plated flanges and a third stalk on its back carrying the eyes and a second mouth. Three legs means one on the centreline and a mirrored rear pair - a tripod support polygon, not the usual rectangle. Neutral bile-brown palette FOR tinting.",
  "palette": {
    "hide_body": { "color": "#7c7157", "rough": 0.95 },
    "hide_tent": { "color": "#847955", "rough": 0.92 },
    "hide_stalk": { "color": "#7a7052", "rough": 0.92 },
    "hide_leg": { "color": "#6f6650", "rough": 0.92 },
    "maw": { "color": "#5a2f2c", "rough": 0.7 },
    "flange": { "color": "#4e4535", "rough": 0.8 },
    "tooth": { "color": "#cdc4a6", "rough": 0.4 },
    "eye": { "color": "#d0c020", "rough": 0.2 }
  },
  "shading": {
    "_note": "Engine lights character parts with high contrast (open gap) - keep the ramp gentle.",
    "gradient": { "top": 0.12, "bottom": -0.22 },
    "noise": { "size": 0.024, "amount": 0.13 }
  },
  "smooth_angle": 55,
