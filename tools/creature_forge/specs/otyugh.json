    "_note_tentacles": "The pair is authored once and mirrored. They rise off the shoulders before reaching forward so the flanges clear the sac - a tentacle that leaves the body horizontally just buries itself in the barrel.",
    "LTentRoot": { "from": "Pelvis", "side": 0.15, "up": 0.15 },
    "LTent1": { "from": "LTentRoot", "side": 0.13, "up": 0.25, "fwd": 0.06 },
