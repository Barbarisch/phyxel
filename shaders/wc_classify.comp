#version 450
#extension GL_GOOGLE_include_directive : require
// WaterCore GPU kernel 4: per cell, the pressure row. liq = 1 for a liquid cell (f >= thr, Air);
// diag = (sum over 6 neighbours: liquid 1, air 1/theta, solid 0) / h^2; rhs = -div(u)/dt plus the
// pump source term (sources buffer, m^3/s per cell, 0 elsewhere) and the ceiling target for a partial
// liquid cell under a solid; p = 0 (RBGS starts from zero, as the CPU's CG does).
// param0 = 1: a PARTICLE transport owns the mass (Phase B2 on the GPU): no ceiling target, but the
// symmetric density control - an over-full cell pushes, a submerged under-full cell in a QUIET cell
// pulls (WaterCore.cpp project(), the ownsMass() branch).
#define WC_BRICKS_BINDING 11
#include "water_core.glsl"
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer F    { float f[]; };
layout(std430, set = 0, binding = 1) readonly buffer Occ  { uint occ[]; };
layout(std430, set = 0, binding = 2) readonly buffer U    { float u[]; };
layout(std430, set = 0, binding = 3) readonly buffer V    { float v[]; };
layout(std430, set = 0, binding = 4) readonly buffer W    { float w[]; };
layout(std430, set = 0, binding = 5) readonly buffer Src  { float src[]; };    // m^3/s per cell
layout(std430, set = 0, binding = 6)          buffer Liq  { uint liq[]; };
layout(std430, set = 0, binding = 7)          buffer Diag { float diag[]; };
layout(std430, set = 0, binding = 8)          buffer Rhs  { float rhs[]; };
layout(std430, set = 0, binding = 9)          buffer P    { float p[]; };
layout(std430, set = 0, binding = 10)         buffer Solid { vec4 solid[]; };   // 20: (s, q, wake, ledger); mode 1 writes q and the ledger mark

bool blocked(int x, int y, int z) { return !inBounds(x, y, z) || occ[cellIdx(x, y, z)] != 0u || frozenCell(x, y, z); }   // 26.31: a frozen column is a wall
bool isLiqCell(int x, int y, int z) {
    if (!inBounds(x, y, z) || occ[cellIdx(x, y, z)] != 0u || frozenCell(x, y, z)) return false;
    const float fv = f[cellIdx(x, y, z)], sv = solid[cellIdx(x, y, z)].x;
    // 20.5: with a body, water + body past the threshold AND real water there (a body in air gets no row)
    return sv > 0.0 ? (fv + sv >= pc.thr && fv >= 0.001 / pc.h) : fv >= pc.thr;
}
// 20.5: a cell full of body with no real water is a wall, not air (WaterSolver::bodyWall)
bool bodyWall(int x, int y, int z) {
    if (!inBounds(x, y, z)) return false;
    const float sv = solid[cellIdx(x, y, z)].x;
    if (sv <= 0.0) return false;
    const float fv = f[cellIdx(x, y, z)];
    return fv < 0.001 / pc.h && fv + sv >= pc.thr;
}
#include "wc_theta.glsl"   // 24.5 F2: the one surface distance (matrix and velocity update)

void main() {
    const uint id = gl_GlobalInvocationID.x;
    if (pc.mode == 2) {
        // 26.9 THE STILL-WATER FIRST GUESS (column threads, after mode 0 has classified every cell). Down each column, a
        // stack of liquid cells under air starts at g x theta x h (the same surface distance as the matrix row) and adds
        // g x h per cell: the discrete still-water solution of this substep's own system, exact for a level resting
        // pool. A pure function of the water NOW - never last substep's pressure (the warm start's stale guess made a
        // threshold surface flicker, 26.8). A stack under rock or a body keeps 0 (no free surface: the sweeps solve it).
        int x, z;
        if (!threadColumn(id, x, z)) return;
        float acc = 0.0;
        bool above = false;   // the cell above is liquid (the stack continues)
        bool open = false;    // the stack has a free surface (not a ceiling) - its top pressure may be exactly 0 (26.9 ghost)
        for (int y = pc.ny - 1; y >= 0; --y) {
            if (absentCell(x, y, z)) { above = false; continue; }   // 26.6: never written
            const uint i = cellIdx(x, y, z);
            if (liq[i] == 0u) { above = false; continue; }
            if (!above) {
                open = !(blocked(x, y + 1, z) || bodyWall(x, y + 1, z));
                acc = open ? pc.gravity * pc.h * wcThetaToAir(x, y, z, 3) + wcSurfaceGhost(x, y, z, 3) : 0.0;
            } else if (open) acc += pc.gravity * pc.h;
            p[i] = acc;
            above = true;
        }
        return;
    }
    ivec3 c;
    if (!threadSite(id, 3, c)) return;
    if (pc.mode == 1) {
        // 20 (M1) WaterSolver::computeSolidRates: q = max(0, f + s - 1) V / T (param0 = T), clamped to (open
        // faces) x h^2 x 20 m/s; fresh (uploaded .w), walled-in and body-filled cells to the column ledger. Reads
        // only f and s (never written here): no thread hazards.
        vec4 sd = solid[id];
        sd.y = 0.0;
        const float excess = f[id] + sd.x - 1.0;
        if (sd.x > 0.0 && excess > 0.0 && sd.w == 0.0) {
            const ivec3 dd[6] = ivec3[6](ivec3(-1,0,0), ivec3(1,0,0), ivec3(0,-1,0), ivec3(0,1,0), ivec3(0,0,-1), ivec3(0,0,1));
            int open = 0;
            for (int k = 0; k < 6; ++k) { const ivec3 n = c + dd[k]; if (!blocked(n.x, n.y, n.z) && !bodyWall(n.x, n.y, n.z)) ++open; }
            if (open == 0 || sd.x >= 0.999) sd.w = 1.0;
            else sd.y = min(excess * pc.h * pc.h * pc.h / pc.param0, float(open) * pc.h * pc.h * 20.0);
        }
        solid[id] = sd;
        return;
    }
    // COLD START, every substep (26.8, 2026-10-13). A warm start (the last pressure as the first guess) made the solve exact
    // and stopped still water creeping into the air - but a surface resting AT the liquid threshold (the bench pond's top
    // layer at f = 0.5) then flickered in a checkerboard (KE 3e-3, never asleep) at small frame steps and lost water
    // (2.2e-5 m^3/s live, 2.8e-4 m^3 in 20 s at dt 1/165 - WaterBrickTest.DISABLED_DiagSettlingLoss); the pond the owner
    // signed off ran cold. Reverted. Since 26.9 mode 2 then writes the still-water guess for liquid cells (when enabled).
    p[id] = 0.0;
    const bool liquid = isLiqCell(c.x, c.y, c.z);
    liq[id] = liquid ? 1u : 0u;
    if (!liquid) { diag[id] = 0.0; rhs[id] = 0.0; return; }
    const ivec3 d[6] = ivec3[6](ivec3(-1,0,0), ivec3(1,0,0), ivec3(0,-1,0), ivec3(0,1,0), ivec3(0,0,-1), ivec3(0,0,1));
    float dsum = 0.0, ghostRhs = 0.0;   // ghostRhs: sum of p_ghost / theta over air faces (26.9), x 1/h^2 below
    for (int k = 0; k < 6; ++k) {
        const ivec3 n = c + d[k];
        if (blocked(n.x, n.y, n.z) || bodyWall(n.x, n.y, n.z)) continue;   // Neumann (a body-full cell is a wall, 20.5)
        if (isLiqCell(n.x, n.y, n.z)) dsum += 1.0;
        else { const float th = wcThetaToAir(c.x, c.y, c.z, k); dsum += 1.0 / th; ghostRhs += wcSurfaceGhost(c.x, c.y, c.z, k) / th; }
    }
    const float invh2 = 1.0 / (pc.h * pc.h);
    // a row with no open neighbour (walled in by rock and body cells) is decoupled: p = 0 (a zero diagonal
    // divided by zero on the CPU and went NaN - WaterSolver::project); its water leaves by the ledger
    const bool isolated = dsum == 0.0;
    diag[id] = isolated ? 1.0 : dsum * invh2;
    // 26.31: a face held by a frozen neighbour (its +x / +z face) keeps that column's last value - closed here, as the wall it is
    const float uHi = frozenCell(c.x + 1, c.y, c.z) ? 0.0 : u[uIdx(c.x + 1, c.y, c.z)];
    const float wHi = frozenCell(c.x, c.y, c.z + 1) ? 0.0 : w[wIdx(c.x, c.y, c.z + 1)];
    const float div = (uHi - u[uIdx(c.x, c.y, c.z)] + v[vIdx(c.x, c.y + 1, c.z)] - v[vIdx(c.x, c.y, c.z)] + wHi - w[wIdx(c.x, c.y, c.z)]) / pc.h;
    float r = -div / pc.dt + ghostRhs * invh2;   // 26.9: a Dirichlet ghost value moves to the right-hand side
    const float q = src[id];
    if (q != 0.0) r += (q / (pc.h * pc.h * pc.h)) / pc.dt;
    const vec4 sd = solid[id];
    if (sd.y > 0.0) r += (sd.y / (pc.h * pc.h * pc.h)) / pc.dt;   // 20.2: shed the water that no longer fits
    const float fc = f[id] + sd.x;   // 20.5: a body's volume counts as filled
    const float vfall = sqrt(2.0 * pc.gravity * pc.h);
    if (pc.param0 == 0.0) {
        if (fc < 1.0 && (blocked(c.x, c.y + 1, c.z) || bodyWall(c.x, c.y + 1, c.z))) {   // ceiling void (rock or a body-full cell) closes at the free-fall rate
            const float df = min(1.0 - fc, vfall * pc.dt / pc.h);
            r -= df / (pc.dt * pc.dt);
        }
        // 20.5 / T10: air a body drags under water rises back out - in the body's WAKE (.z > 0) only, a void
        // under a FULL cell takes an inflow at the trapped-bubble rise speed (0.25 m/s), in quiet water.
        // Same rule as WaterSolver::project (why each limit: there).
        if (sd.z > 0.0 && c.y + 1 < pc.ny && !blocked(c.x, c.y + 1, c.z) && fc < 1.0) {
            const float fa = f[cellIdx(c.x, c.y + 1, c.z)], sa = solid[cellIdx(c.x, c.y + 1, c.z)].x;
            if (fa + sa >= 0.999 && fa >= 0.001 / pc.h) {
                const float vAbove = abs(v[vIdx(c.x, c.y + 1, c.z)]);
                const float uc = 0.5 * (u[uIdx(c.x, c.y, c.z)] + u[uIdx(c.x + 1, c.y, c.z)]);
                const float wc = 0.5 * (w[wIdx(c.x, c.y, c.z)] + w[wIdx(c.x, c.y, c.z + 1)]);
                if (vAbove < 0.1 * vfall && uc * uc + wc * wc < 0.01 * vfall * vfall) {
                    const float df = min(1.0 - fc, 0.25 * pc.dt / pc.h);
                    r -= df / (pc.dt * pc.dt);
                }
            }
        }
        // 26.21 THE VOLUME CORRECTION (param1 = T, s; 0 = off): a BURIED part-full liquid cell - water above it, no side
        // face to air - is air inside the water; it asks for the net inflow that returns its missing share over T. Same rule
        // as WaterSolver::project (why each gate: there).
        if (pc.param1 > 0.0 && fc < 1.0 - pc.vcBand && c.y + 1 < pc.ny && !blocked(c.x, c.y + 1, c.z) && !bodyWall(c.x, c.y + 1, c.z)) {
            const float fa = f[cellIdx(c.x, c.y + 1, c.z)], sa = solid[cellIdx(c.x, c.y + 1, c.z)].x;
            if (fa >= 0.001 / pc.h) {   // any water above (the CPU's s_volumeCorrectionUnderFilm, the default)
                bool sideAir = false;
                for (int k = 0; k < 6; ++k) {
                    if (k == 2 || k == 3) continue;
                    const ivec3 n = c + d[k];
                    if (blocked(n.x, n.y, n.z) || bodyWall(n.x, n.y, n.z)) continue;
                    if (!isLiqCell(n.x, n.y, n.z)) sideAir = true;
                }
                if (!sideAir) {
                    const float gap = min(1.0 - fc, fa);   // only what the water above can give (26.21)
                    const float df = min(gap * pc.dt / pc.param1, gap);
                    r -= df / (pc.dt * pc.dt);
                }
            }
        }
    } else {
        if (fc > 1.0) {
            const float df = min(fc - 1.0, vfall * pc.dt / pc.h);
            r += df / (pc.dt * pc.dt);
        } else if (fc < 1.0 && c.y + 1 < pc.ny && !blocked(c.x, c.y + 1, c.z) && f[cellIdx(c.x, c.y + 1, c.z)] > 0.0) {
            const float vFace = v[vIdx(c.x, c.y + 1, c.z)];
            const float uc = 0.5 * (u[uIdx(c.x, c.y, c.z)] + u[uIdx(c.x + 1, c.y, c.z)]);
            const float wc = 0.5 * (w[wIdx(c.x, c.y, c.z)] + w[wIdx(c.x, c.y, c.z + 1)]);
            if (abs(vFace) * pc.dt / pc.h < 0.1 * vfall * pc.dt / pc.h && uc * uc + wc * wc < 0.01 * vfall * vfall) {
                const float df = min(1.0 - fc, vfall * pc.dt / pc.h);
                r -= df / (pc.dt * pc.dt);
            }
        }
    }
    rhs[id] = isolated ? 0.0 : r;
}
