#version 450
#extension GL_GOOGLE_include_directive : require
#include "particle_types.glsl"
#include "solver_types.glsl"

// Dynamic body vs. STATIC voxel contacts. Geometry lives in voxel_contact.glsl (shared
// with the hard-contact safety pass) — read its header for why the old per-voxel SAT
// made debris bubble.

layout(local_size_x = WORKGROUP_SOLVER) in;

layout(std430, set=0, binding=0) buffer SolverBodyBuffer  { SolverBody bodies[]; };
layout(std430, set=0, binding=1) buffer ConstraintBuffer  { GPUConstraint constraints[]; };
layout(std430, set=0, binding=2) buffer SolverStateBuffer { uint solverState[]; };
layout(std430, set=0, binding=3) readonly buffer OccupancyBuffer { uint occupancy[]; };
layout(std430, set=0, binding=4) readonly buffer WarmstartBuffer { WarmstartEntry warmstarts[]; };

layout(push_constant) uniform PC {
    uint  count;
    uint  maxConstraints;
    uint  flags;          // SOLVER_FLAG_* (runtime A/B of the settling fixes)
    float coldScale;      // cold-contact stiffness = coldScale * m/dt^2
} pc;

#include "voxel_contact.glsl"

// A box resting in a pit corner touches up to three faces; the AVBD primal aggregates all of
// them in one 6x6 solve. Selection keeps the deepest point per normal direction first (so a
// wall is never starved by the floor), then fills by depth, preferring corners (widest base).
const int MAX_VOXEL_CONTACTS = 6;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;

    SolverBody bA = bodies[i];
    if ((bA.flags & PARTICLE_ACTIVE) == 0u || bA.invMass == 0.0) return;

    vec3 pos  = bA.pos;
    vec3 h    = bA.halfExt;
    vec4 quat = bA.quat;

    // Speculative band: keep contacts for points up to this far above a surface, so a
    // resting body never loses its constraint (and its warm-started force) between ticks.
    const float margin = max(COLLISION_MARGIN, 0.02);

    float cPen[VOXEL_SAMPLES];
    vec3  cN  [VOXEL_SAMPLES];
    vec3  cR  [VOXEL_SAMPLES];
    int   cDir[VOXEL_SAMPLES];
    bool  cUsed[VOXEL_SAMPLES];
    int   nCand = 0;
    int   sampleOf[VOXEL_SAMPLES];

    for (int k = 0; k < VOXEL_SAMPLES; ++k) {
        vec3 local = voxelSampleLocal(k) * h;
        vec3 rW    = quatRotate(quat, local);
        vec3 n; float pen; int dir;
        if (!voxelPointContact(pos + rW, margin, n, pen, dir)) continue;
        cPen[nCand] = pen; cN[nCand] = n; cR[nCand] = rW; cDir[nCand] = dir;
        cUsed[nCand] = false; sampleOf[nCand] = k;
        ++nCand;
    }
    if (nCand == 0) return;

    int chosen[MAX_VOXEL_CONTACTS];
    int nChosen = 0;
    // Pass 1: deepest per escape direction (26-neighbourhood).
    for (int d = 0; d < 26 && nChosen < MAX_VOXEL_CONTACTS; ++d) {
        int best = -1; float bestScore = -1e30;
        for (int c = 0; c < nCand; ++c) {
            if (cDir[c] != d) continue;
            float s = cPen[c] + (voxelSampleIsCorner(sampleOf[c]) ? 0.002 : 0.0);
            if (s > bestScore) { bestScore = s; best = c; }
        }
        if (best >= 0) { chosen[nChosen++] = best; cUsed[best] = true; }
    }
    // Pass 2: fill by depth (corners preferred).
    while (nChosen < MAX_VOXEL_CONTACTS) {
        int best = -1; float bestScore = -1e30;
        for (int c = 0; c < nCand; ++c) {
            if (cUsed[c]) continue;
            float s = cPen[c] + (voxelSampleIsCorner(sampleOf[c]) ? 0.002 : 0.0);
            if (s > bestScore) { bestScore = s; best = c; }
        }
        if (best < 0) break;
        chosen[nChosen++] = best; cUsed[best] = true;
    }

    for (int q = 0; q < nChosen; ++q) {
        int   c      = chosen[q];
        vec3  normal = cN[c];
        float pen    = cPen[c];
        vec3  rA_w   = cR[c];

        // Feature = (body sample, face direction): stable while the body slides across
        // voxel boundaries, unlike the old per-voxel key.
        uint featureKey = uint(sampleOf[c]) * 26u + uint(cDir[c]) + 1u;
        uint wsKey      = packKey(i, 0xFFFF0000u, featureKey);

        // ---- Warmstart lookup (cold-fallback default if absent) ----
        WarmstartEntry ws;
        ws.lambdaN=0.0; ws.penaltyN=PENALTY_MIN;
        ws.lambdaF1=0.0; ws.penaltyF1=PENALTY_MIN;
        ws.lambdaF2=0.0; ws.penaltyF2=PENALTY_MIN;
        ws.stick=0u; ws.featureKey=FEATURE_KEY_NONE;
        ws.rA=vec3(0); ws.pad0=0.0; ws.rB=vec3(0); ws.pad1=0.0;
        {
            uint slot0 = hashKey(wsKey) & HASH_MASK;
            for (uint p = 0u; p < MAX_PROBE; p++) {
                uint idx    = (slot0 + p) & HASH_MASK;
                uint stored = solverState[HASH_BASE + idx];
                if (stored == HASH_EMPTY) break;
                if (stored == wsKey) {
                    WarmstartEntry e = warmstarts[idx];
                    if (e.featureKey == featureKey) {
                        if (isNanOrInf(e.lambdaN) || isNanOrInf(e.penaltyN) ||
                            isNanOrInf(e.lambdaF1) || isNanOrInf(e.penaltyF1) ||
                            isNanOrInf(e.lambdaF2) || isNanOrInf(e.penaltyF2)) {
                            atomicAdd(solverState[SS_WARMSTART_NAN], 1u);
                        } else {
                            if (e.penaltyN > PENALTY_MIN) atomicAdd(solverState[SS_WARMSTART_LOADED], 1u);
                            atomicAdd(solverState[SS_WARMSTART_HITS], 1u);
                            ws = e;
                        }
                    }
                    break;
                }
            }
        }

        uint slot = atomicAdd(solverState[SS_CONSTRAINT_COUNT], 1u);
        if (slot >= pc.maxConstraints) return;

        vec3 t1, t2;
        tangentBasis(normal, t1, t2);

        // Store body-A arm in LOCAL space; bodyB is static so rB unused.
        vec3 rA_local = quatRotate(quatInv(quat), rA_w);

        // A cold contact starts at the body's own inertial stiffness (m/dt²-class) instead of
        // PENALTY_MIN = 1: with κ = 1 a landing body sinks centimetres before the penalty ramp
        // catches up, and the climb back out is injected energy (three-avbd "massPenalty").
        float coldPenalty = (1.0 / bA.invMass) * COLD_PENALTY_DT2_INV * pc.coldScale;
        bool  cold        = (ws.featureKey == FEATURE_KEY_NONE);

        GPUConstraint con;
        con.n          = normal;
        con.depth      = pen;
        con.rA         = rA_local;
        con.lambdaN    = ws.lambdaN  * ALPHA;
        con.rB         = vec3(0);
        con.lambdaF1   = ws.lambdaF1 * ALPHA;
        con.t1         = t1;
        con.lambdaF2   = ws.lambdaF2 * ALPHA;
        con.bodyA      = i;
        con.bodyB      = SOLVER_STATIC;
        con.mu         = bA.friction;
        con.color      = UNCOLORED;
        bool  massPen     = (pc.flags & SOLVER_FLAG_MASS_PENALTY) != 0u;
        con.penalty_n  = clamp((cold && massPen) ? coldPenalty : ws.penaltyN * GAMMA,
                               PENALTY_MIN, PENALTY_MAX);
        // Detected at the PREDICTED iterate; the solver measures motion (J·Δq) from the tick
        // start, so convert back: pen0 = pen_pred + J·Δq_pred. Storing pen_pred directly
        // counted this tick's predicted motion twice — a body falling 10 cm/tick "penetrated"
        // 10 cm too deep and was shoved back out (a bounce on every impact, ∝ speed).
        float jdq = dot(normal, bA.pos - bA.initial) + dot(cross(rA_w, normal), bA.cumAng);
        con.C_init_n   = pen + jdq;      // C = 0 at touching → rests FLUSH
        // ---- Static friction (AVBD paper §3.3; three-avbd keeps anchors while sticking) ----
        // Friction rows used to start at PENALTY_MIN = 1 and were never anchored (C_init_t was
        // always 0, the persisted `stick` flag unread), so friction could only slow sliding,
        // never HOLD: every tick lost 1% of the friction force to the alpha-decayed warm start
        // and had to slip a little to rebuild it — leaning/stacked debris crept for seconds.
        // Now: cold friction rows start stiff, and a sticking contact keeps its world anchor
        // (stored in rB — unused by static rows) so accumulated drift is pulled back.
        bool  sFric   = (pc.flags & SOLVER_FLAG_STATIC_FRICTION) != 0u;
        vec3  ptStart = bA.initial + quatRotate(bA.initialQuat, rA_local);   // sample at tick start
        vec3  anchor  = (sFric && !cold && ws.stick != 0u) ? ws.rB : ptStart;
        con.rB         = anchor;
        con.C_init_t1  = sFric ? dot(t1, ptStart - anchor) : 0.0;
        con.C_init_t2  = sFric ? dot(t2, ptStart - anchor) : 0.0;
        float penT1 = (sFric && cold) ? coldPenalty : ws.penaltyF1 * GAMMA;
        float penT2 = (sFric && cold) ? coldPenalty : ws.penaltyF2 * GAMMA;
        con.penalty_t1 = clamp(penT1, PENALTY_MIN, PENALTY_MAX);
        con.penalty_t2 = clamp(penT2, PENALTY_MIN, PENALTY_MAX);
        con.featureKey = featureKey;
        con.wsKey      = wsKey;
        con.isNew      = cold ? 1u : 0u;
        con.stick      = ws.stick;
        con.pad0       = 0.0;
        con.pad1       = 0.0;

        constraints[slot] = con;
    }
}
