#version 450
#extension GL_GOOGLE_include_directive : require
#include "particle_types.glsl"
#include "solver_types.glsl"

// solver_warmstart_save.comp — at end of physics tick, persist final lambda/penalty/stick
// into the warmstart hash table keyed on each constraint's wsKey. Next frame the
// narrowphase looks them up to seed `pushConstraint` so contacts converge in 1-2 iters.
//
// Bindings:
//   0: constraints (ro)
//   1: warmstarts  (rw, sized HASH_CAP entries)
//   2: solverState (rw, hosts the hash table from HASH_BASE..HASH_BASE+HASH_CAP)

layout(local_size_x = WORKGROUP_SOLVER) in;

layout(std430, set=0, binding=0) readonly buffer ConstraintBuffer { GPUConstraint constraints[]; };
layout(std430, set=0, binding=1) buffer WarmstartBuffer           { WarmstartEntry warmstarts[]; };
layout(std430, set=0, binding=2) buffer SolverStateBuffer         { uint solverState[]; };
// Phase 6a: this frame slot's mover push-back accumulator (MAX_KINEMATIC x ivec4, solver_shared.h).
layout(std430, set=0, binding=3) buffer MoverPushBuffer           { int moverPush[]; };
layout(std430, set=0, binding=4) readonly buffer SolverBodyBuffer { SolverBody bodies[]; };

layout(push_constant) uniform PC { PHX_PC_CONSTRAINTS } pc;  // shaders/solver_shared.h

uint hashInsert(uint key) {
    uint slot = hashKey(key) & HASH_MASK;
    for (uint p = 0u; p < MAX_PROBE; p++) {
        uint idx = (slot + p) & HASH_MASK;
        uint old = atomicCompSwap(solverState[HASH_BASE + idx], HASH_EMPTY, key);
        if (old == HASH_EMPTY || old == key) {
            return idx;
        }
    }
    return HASH_CAP;  // overflow
}

void main() {
    uint ci = gl_GlobalInvocationID.x;
    uint constraintCount = solverState[SS_CONSTRAINT_COUNT];
    if (ci >= constraintCount || ci >= pc.maxConstraints) return;

    GPUConstraint con = constraints[ci];

    // Phase 6a: the final normal force this contact puts on a mover (body B), per tick, capped at
    // the momentum its debris body (A) can absorb this tick (solver_shared.h MOVER_PUSH_*).
    // (No lambdaN < 0 gate: an impact's lambda has already relaxed to 0 - the momentum term below
    // is what sees it.)
    if (isKinematicBody(con.bodyB) && con.bodyA < KINEMATIC_BASE) {
        const uint k = con.bodyB - KINEMATIC_BASE;
        const SolverBody A = bodies[con.bodyA];
        const SolverBody B = bodies[con.bodyB];
        const float mA = (A.invMass > 0.0) ? 1.0 / A.invMass : 0.0;    // a sleeper (static) takes none
        const float closing = max(0.0, dot(B.vel - A.prevVel, con.n));  // n: mover -> debris
        const float jCap = mA * (closing + SOLVER_GRAVITY_ABS * SOLVER_TICK_DT);
        // Two measures of the same push, take the larger: the final multiplier (a SUSTAINED
        // contact - walking into a pile) and the debris' momentum change along n this tick (an
        // IMPACT - a thrown piece bounces off within the tick's iterations, its constraint
        // separates and the final lambda relaxes to 0: measured live, 36-65 deep contacts from
        // a block thrown at an NPC read back as zero push).
        const vec3  vAfter    = (A.pos - A.initial) / SOLVER_TICK_DT;
        const float jMomentum = mA * max(0.0, dot(vAfter - A.prevVel, con.n));
        const float j    = min(max(-con.lambdaN * SOLVER_TICK_DT, jMomentum), jCap);
        const float fMag = j / SOLVER_TICK_DT;
        const vec3 f = -con.n * fMag * MOVER_PUSH_SCALE;              // force on the mover
        if (fMag > 0.0) {
            atomicAdd(moverPush[k * 4u + 0u], int(clamp(f.x, -2.0e9, 2.0e9)));
            atomicAdd(moverPush[k * 4u + 1u], int(clamp(f.y, -2.0e9, 2.0e9)));
            atomicAdd(moverPush[k * 4u + 2u], int(clamp(f.z, -2.0e9, 2.0e9)));
            atomicAdd(moverPush[k * 4u + 3u], 1);
        }
    }
    if (con.wsKey == HASH_EMPTY) return;

    uint idx = hashInsert(con.wsKey);
    if (idx >= HASH_CAP) return;

    WarmstartEntry ws;
    ws.lambdaN    = con.lambdaN;
    ws.penaltyN   = con.penalty_n;
    ws.lambdaF1   = con.lambdaF1;
    ws.penaltyF1  = con.penalty_t1;
    ws.lambdaF2   = con.lambdaF2;
    ws.penaltyF2  = con.penalty_t2;
    ws.stick      = con.stick;
    ws.featureKey = con.featureKey;
    ws.rA         = con.rA;
    ws.pad0       = 0.0;
    ws.rB         = con.rB;
    ws.pad1       = 0.0;
    warmstarts[idx] = ws;
}
