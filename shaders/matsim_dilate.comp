#version 450
// docs/MaterialSimPlan.md §6c — MatSim P1b sleep mask: a brick is processed this tick when any
// brick in its 3^3 neighbourhood moved on tick-1 or tick-2 (MatSimCore::step's dilation, as a
// gather). Also clears this tick's "moved" marks, which no other pass of this tick reads.
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer M1 { uint marks1[]; };   // moved on tick-1
layout(std430, binding = 1) readonly buffer M2 { uint marks2[]; };   // moved on tick-2
layout(std430, binding = 2) writeonly buffer Proc { uint process[]; };
layout(std430, binding = 3) writeonly buffer Fresh { uint fresh[]; };

layout(push_constant) uniform PC {
    ivec4 brickDim;   // xyz; w = brick count
    ivec4 stride;     // x = invocation stride of a dispatch row
} pc;

void main() {
    const uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * uint(pc.stride.x);
    if (i >= uint(pc.brickDim.w)) return;
    const int X = pc.brickDim.x, Z = pc.brickDim.z, Y = pc.brickDim.y;
    const int x = int(i % uint(X));
    const int z = int((i / uint(X)) % uint(Z));
    const int y = int(i / uint(X * Z));
    uint any = 0u;
    for (int dy = -1; dy <= 1; ++dy)
        for (int dz = -1; dz <= 1; ++dz)
            for (int dx = -1; dx <= 1; ++dx) {
                const int a = x + dx, b = y + dy, c = z + dz;
                if (a < 0 || b < 0 || c < 0 || a >= X || b >= Y || c >= Z) continue;
                const uint j = uint(a) + uint(X) * (uint(c) + uint(Z) * uint(b));
                any |= marks1[j] | marks2[j];
            }
    process[i] = any != 0u ? 1u : 0u;
    fresh[i] = 0u;
}
