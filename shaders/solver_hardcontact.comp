#version 450
#extension GL_GOOGLE_include_directive : require
#include "particle_types.glsl"
#include "solver_types.glsl"

// =====================================================================
// Hard-contact safety pass: post-solve positional projection of dynamic bodies out of the
// static voxel grid, for overlap the soft AVBD solve failed to resolve.
//
// Uses the SAME contact geometry as solver_voxel.comp (voxel_contact.glsl): only EXPOSED
// voxel faces can push, so a body sunk into a flat floor is pushed UP, never sideways or
// down through the slab (the old per-voxel MTV did both — tunnelling and sideways kicks).
//
// It acts only on genuine failures (overlap > HC_THRESH), not on the ~mm residual every
// soft contact carries at rest — the old pass fired on nearly every resting body every
// tick. And because sync_out derives velocity from (pos - initial)/dt, a push applied to
// pos alone BECOMES upward launch velocity (1 cm/tick = 0.6 m/s); with SOLVER_FLAG_HC_NEUTRAL
// the push moves `initial` with it, so the correction is positional only, and any velocity
// INTO the surface is removed.
// =====================================================================

layout(local_size_x = WORKGROUP_SOLVER) in;

layout(std430, set=0, binding=0) buffer SolverBodyBuffer { SolverBody bodies[]; };
layout(std430, set=0, binding=1) readonly buffer OccupancyBuffer { uint occupancy[]; };
// Settle-probe telemetry only (SS_HARDCONTACT_*): how often this non-physical clamp fires.
layout(std430, set=0, binding=2) buffer SolverStateBuffer { uint solverState[]; };

layout(push_constant) uniform PC { PHX_PC_HARDCONTACT } pc;  // shaders/solver_shared.h

#include "voxel_contact.glsl"

const float HC_THRESH = 0.01;   // m — below this the soft contact is doing its job

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;

    SolverBody b = bodies[i];
    if ((b.flags & PARTICLE_ACTIVE) == 0u || b.invMass <= 0.0) return;

    float bestPen = 0.0;
    vec3  bestN   = vec3(0.0);
    bool  anyExposed = false;
    for (int k = 0; k < VOXEL_SAMPLES; ++k) {
        vec3 x = b.pos + quatRotate(b.quat, voxelSampleLocal(k) * b.halfExt);
        vec3 n; float pen; int dir;
        if (!voxelPointContact(x, 0.0, n, pen, dir)) continue;
        anyExposed = true;
        if (pen > bestPen) { bestPen = pen; bestN = n; }
    }

    vec3 push = vec3(0.0);
    if (bestPen > HC_THRESH) {
        push = bestN * bestPen;
    } else if (!anyExposed && isOccupiedI(ivec3(floor(b.pos)))) {
        // Fully embedded (centre in solid, no sample near an exposed face): lift to the
        // first open cell above — the only direction guaranteed not to tunnel.
        ivec3 c = ivec3(floor(b.pos));
        for (int k = 1; k <= 4; ++k) {
            if (!isOccupied(c.x, c.y + k, c.z)) {
                float wy = abs(quatRotate(b.quat, vec3(1, 0, 0)).y) * b.halfExt.x
                         + abs(quatRotate(b.quat, vec3(0, 1, 0)).y) * b.halfExt.y
                         + abs(quatRotate(b.quat, vec3(0, 0, 1)).y) * b.halfExt.z;
                push = vec3(0.0, float(c.y + k) + wy - b.pos.y, 0.0);
                bestN = vec3(0.0, 1.0, 0.0);
                bestPen = push.y;
                break;
            }
        }
    }
    if (dot(push, push) <= 0.0) return;

    if ((pc.flags & SOLVER_FLAG_HC_NEUTRAL) != 0u) {
        // Positional-only correction: keep this tick's displacement (= velocity) minus any
        // component INTO the surface; the push itself carries no velocity.
        vec3  disp = b.pos - b.initial;
        float vn   = dot(disp, bestN);
        if (vn < 0.0) disp -= bestN * vn;
        b.pos    += push;
        b.initial = b.pos - disp;
        bodies[i].initial = b.initial;
        // Post-stab path takes velocity from b.vel: drop its into-surface component too.
        float vv = dot(b.vel, bestN);
        if (vv < 0.0) bodies[i].vel = b.vel - bestN * vv;
    } else {
        // Legacy behaviour (A/B only): the push lands in pos alone → becomes velocity.
        b.pos += push;
    }
    bodies[i].pos = b.pos;

    atomicAdd(solverState[SS_HARDCONTACT_FIRES], 1u);
    atomicMax(solverState[SS_HARDCONTACT_DEPTH_UM], uint(min(bestPen, 4000.0) * 1.0e6));
}
