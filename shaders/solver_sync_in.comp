#version 450
#extension GL_GOOGLE_include_directive : require
#include "particle_types.glsl"
#include "solver_types.glsl"

layout(local_size_x = WORKGROUP_SOLVER) in;

layout(std430, set=0, binding=0) readonly buffer ParticleBuffer  { GpuParticle particles[]; };
layout(std430, set=0, binding=1) buffer SolverBodyBuffer         { SolverBody  bodies[]; };
layout(std430, set=0, binding=2) buffer SolverStateBuffer        { uint solverState[]; };
layout(std430, set=0, binding=3) readonly buffer MaterialBuffer  { MaterialPhysics materials[]; };
// Phase 4: this frame's impulses (host-mapped, one buffer per frame slot; solver_shared.h).
struct Impulse { PHX_IMPULSE };
layout(std430, set=0, binding=4) readonly buffer ImpulseBuffer   { Impulse impulses[]; };
// Phase 6: this frame slot's event readback (solver_shared.h, DEBRIS_EVENT_*).
struct DebrisEvent { PHX_DEBRIS_EVENT };
layout(std430, set=0, binding=5) buffer EventBuffer { uint eventCount; uint ePad0, ePad1, ePad2; DebrisEvent events[]; };

void emitWake(uint slot, GpuParticle p) {
    uint k = atomicAdd(eventCount, 1u);
    if (k >= MAX_DEBRIS_EVENTS) return;
    events[k].info     = uvec4(slot, DEBRIS_EVENT_WAKE, p.materialIndex, 0u);
    events[k].posScale = vec4(p.position, max(p.scale.x, max(p.scale.y, p.scale.z)));
}

layout(push_constant) uniform PC { PHX_PC_SYNC_IN } pc;  // shaders/solver_shared.h

void main() {
    uint i = gl_GlobalInvocationID.x;

    if (i >= pc.count) return;

    GpuParticle p = particles[i];

    SolverBody b;
    b.particleIdx = i;
    b.flags       = p.flags;
    b.pos         = p.position;
    b.quat        = p.rotation;
    b.angVel      = p.angularVel;
    b.halfExt     = p.scale * 0.5;
    b.pad0        = 0.0;
    b.pad1        = 0.0;
    b.pad2        = 0.0; b.pad3 = 0.0; b.pad4 = 0.0; b.pad5 = 0.0;
    b.initial     = vec3(0.0); b.pad6 = 0.0;
    b.initialQuat = vec4(0.0, 0.0, 0.0, 1.0);
    b.inertial    = vec3(0.0); b.pad7 = 0.0;
    b.inertialQuat= vec4(0.0, 0.0, 0.0, 1.0);
    b.cumAng      = vec3(0.0); b.pad8 = 0.0;

    // Sphere radius: circumscribed sphere of the AABB
    float r  = max(b.halfExt.x, max(b.halfExt.y, b.halfExt.z));
    b.radius = r;

    // Derive velocity from XPBD prevPosition (convert displacement→m/s)
    b.vel     = (p.position - p.prevPosition) / pc.dt;
    b.prevVel = b.vel;

    if ((p.flags & PARTICLE_ACTIVE) == 0u) {
        b.invMass    = 0.0;
        b.invInertia = 0.0;
        b.friction   = 0.5;
        b.restitution= 0.3;
        bodies[i] = b;
        return;
    }

    // ---- Impulses (Phase 4): push EXISTING debris. dv = J * w(d) / m along the push direction
    // (radial from the origin, blended toward +Y by the up bias), summed over this frame's
    // impulses and clamped to IMPULSE_MAX_DV. Bodies of spawn age 0 have never ticked: they are
    // debris this same blast just created, which already carries its own launch velocity - a
    // second kick would double it. pc.impulseCount is 0 on every tick but the frame's first.
    vec3 dv = vec3(0.0);
    bool inWakeReach = false;   // within IMPULSE_WAKE_SCALE x an impulse's radius (see solver_shared.h)
    uint spawnAge = (p.flags >> SPAWN_AGE_SHIFT) & 0xFFu;
    if (pc.impulseCount > 0u && spawnAge > 0u) {
        float m = max(materials[p.materialIndex & MATERIAL_MASK].mass, 1e-3);
        for (uint k = 0u; k < pc.impulseCount; ++k) {
            Impulse im = impulses[k];
            vec3  off = p.position - im.centerRadius.xyz;
            float d   = length(off);
            if (d < im.centerRadius.w * IMPULSE_WAKE_SCALE) inWakeReach = true;
            float w   = phxImpulseWeight(d, im.centerRadius.w);
            if (w <= 0.0) continue;
            vec3 radial = (d > 1e-4) ? off / d : vec3(0.0, 1.0, 0.0);
            if (im.dirCos.w != IMPULSE_RADIAL && dot(radial, im.dirCos.xyz) < im.dirCos.w) continue;
            vec3 blended = mix(radial, vec3(0.0, 1.0, 0.0), clamp(im.params.y, 0.0, 1.0));
            vec3 dir = (length(blended) > 1e-4) ? normalize(blended) : vec3(0.0, 1.0, 0.0);
            dv += dir * (im.params.x * w / m);
        }
        float s = length(dv);
        if (s > IMPULSE_MAX_DV) dv *= IMPULSE_MAX_DV / s;
    }
    bool pushed = dot(dv, dv) > 1e-8;
    if (pushed) atomicAdd(solverState[SS_IMPULSES_APPLIED], 1u);

    // ---- Sleep (Phase 2): consume wake bit or freeze ----
    if ((p.flags & PARTICLE_SLEEPING) != 0u && (pushed || inWakeReach)) {
        b.flags &= ~PARTICLE_SLEEPING;            // an impulse wakes the body it reaches, and the
                                                  // pile around it, so contacts carry the push
        b.flags &= ~SLEEP_CTR_MASK;
        emitWake(i, p);
    } else if ((p.flags & PARTICLE_SLEEPING) != 0u) {
        uint word = WAKE_BITS_BASE + (i >> 5u);
        uint bit  = 1u << (i & 31u);
        if ((solverState[word] & bit) != 0u) {
            atomicAnd(solverState[word], ~bit);   // consume the wake request
            b.flags &= ~PARTICLE_SLEEPING;        // dynamic again from this tick on
            b.flags &= ~SLEEP_CTR_MASK;           // sleep counter restarts
            emitWake(i, p);                       // Phase 6: no longer settled
        } else {
            // Frozen: static for every downstream pass. Narrowphase still pairs it
            // with awake bodies (they rest on it / wake it); integrate holds the pose;
            // voxel/primal/hardcontact skip invMass == 0.
            MaterialPhysics smat = materials[p.materialIndex & MATERIAL_MASK];
            b.invMass    = 0.0;
            b.invInertia = 0.0;
            b.friction   = smat.friction;
            b.restitution= smat.restitution;
            b.vel        = vec3(0.0);
            b.prevVel    = vec3(0.0);
            b.angVel     = vec3(0.0);
            bodies[i] = b;
            return;
        }
    }

    MaterialPhysics mat = materials[p.materialIndex & MATERIAL_MASK];
    float mass = mat.mass;
    b.invMass    = (mass > 0.0) ? 1.0 / mass : 0.0;
    // Solid sphere: I = 2/5 * m * r²
    float I      = (2.0/5.0) * mass * r * r;
    b.invInertia = (I > 0.0) ? 1.0 / I : 0.0;
    b.friction   = mat.friction;
    b.restitution= mat.restitution;
    b.vel       += dv;

    bodies[i] = b;
}
