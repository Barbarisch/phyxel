#version 450
#extension GL_GOOGLE_include_directive : require
#include "particle_types.glsl"
#include "solver_types.glsl"

layout(local_size_x = WORKGROUP_SOLVER) in;

layout(std430, set=0, binding=0) readonly buffer SolverBodyBuffer { SolverBody bodies[]; };
layout(std430, set=0, binding=1) buffer ParticleBuffer            { GpuParticle particles[]; };

layout(push_constant) uniform PC {
    uint  count;
    float dt;
    float lifetimeDt;
    float pad;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;

    SolverBody  b = bodies[i];
    GpuParticle p = particles[i];

    // Lifetime drain
    p.lifetime -= pc.lifetimeDt;
    if (p.lifetime <= 0.0) {
        p.flags &= ~PARTICLE_ACTIVE;
        particles[i] = p;
        return;
    }

    if ((b.flags & PARTICLE_ACTIVE) == 0u) {
        particles[i] = p;
        return;
    }

    // ---- Sleep (Phase 2): frozen bodies hold their pose EXACTLY ----
    // b still carries the SLEEPING flag from sync_in (no wake bit consumed this tick).
    // Do NOT re-derive velocity or touch position/rotation — the encoded state was
    // zeroed at freeze time and must stay bit-identical until something wakes it.
    if ((b.flags & PARTICLE_SLEEPING) != 0u) {
        p.flags = b.flags;
        particles[i] = p;
        return;
    }

    // Derive velocity from solved position change (AVBD / Shallot convention)
    vec3 solvedVel    = (b.pos - b.initial) / pc.dt;
    // Derive angular velocity from quaternion change
    vec4 dqFinal      = quatMul(b.quat, quatInv(b.initialQuat));
    vec3 solvedAngVel = 2.0 * dqFinal.xyz / pc.dt;

    // Write back solved state
    p.position    = b.pos;
    // XPBD prevPosition encodes velocity: vel = (pos - prevPos) / dt
    p.prevPosition = b.initial;  // initial = position at frame start
    p.rotation    = b.quat;
    p.angularVel  = solvedAngVel;
    p.flags       = b.flags;

    // Increment spawn age (saturates at 255)
    uint age = (p.flags >> SPAWN_AGE_SHIFT) & 0xFFu;
    if (age < 255u) {
        age++;
        p.flags = (p.flags & ~SPAWN_AGE_MASK) | (age << SPAWN_AGE_SHIFT);
    }

    // ---- Sleep (Phase 2): consecutive-slow-tick counter → freeze ----
    // Counts ticks where both linear and angular surface speed are below threshold
    // (past the spawn grace, so fresh debris always gets its ballistic phase). On
    // reaching SLEEP_TICKS: set SLEEPING and zero the encoded velocity. From the next
    // tick sync_in gives the body invMass 0 and the solver stops touching it.
    float linSpeed = length(solvedVel);
    float angSpeed = length(solvedAngVel) * b.radius;
    bool strictSlow = linSpeed < SLEEP_LIN_SPEED && angSpeed < SLEEP_ANG_SPEED;
    bool laxSlow    = linSpeed < SLEEP_LAX_SPEED && angSpeed < SLEEP_LAX_SPEED;
    uint ctr = (p.flags & SLEEP_CTR_MASK) >> SLEEP_CTR_SHIFT;
    if (age > SLEEP_GRACE && laxSlow) {
        ctr = min(ctr + 1u, 255u);
        // Strict tier freezes fast; the lax tier force-freezes chronic slow churners.
        if ((strictSlow && ctr >= SLEEP_TICKS) || ctr >= SLEEP_FORCE_TICKS) {
            p.flags       |= PARTICLE_SLEEPING;
            p.prevPosition = p.position;      // encoded velocity → exactly zero
            p.angularVel   = vec3(0.0);
        }
    } else {
        ctr = 0u;
    }
    p.flags = (p.flags & ~SLEEP_CTR_MASK) | (ctr << SLEEP_CTR_SHIFT);

    particles[i] = p;
}
