#version 450
#extension GL_GOOGLE_include_directive : require
// WaterCore GPU kernel 9: rest-detection reductions with a FIXED order (no float atomics - the rest
// decision must be deterministic, docs/WaterCore.md §15.11).
//   mode 0: per 128-cell half of a workgroup of 256 cells -> partial[2 wg + half] = (sum f*|v_c|^2/2, max |f - fPrev|, sum f)
//           (26.17: one partial per 8 x 2 x 8 UNIT of a bricked volume - each laid the same whatever the brick height)
//           (velocity at the cell centre from its faces, as WaterGrid::kineticEnergy)
//   mode 1: per workgroup of 256 faces of lattice iparam (0 u, 1 v, 2 w) -> partialMax[wg] = max |vel|
//   mode 2: fold `param0` partials of binding 5 into binding 7 (one per workgroup) - or, when
//   mode 4: per workgroup of 256 cells -> partial.w = max residual (binding 8)
//   mode 5: per workgroup of 256 columns -> partial.x = sum of dropped residue (binding 9)
//           param1 == 1, into out[iparam] (the final fold). mode 3: the same from binding 7 into
//           binding 5. The host alternates 2/3 until one workgroup remains: a fixed tree, no atomics.
//   mode 6 (26.6, bricked): gather mode 0's per-unit partials (part, in SLOT order) into the volume's world-aligned UNIT map
//           (part2: x 8, y 2, z 8 cells; an absent brick's units as zero) - the fold that follows is then the same tree
//           whichever bricks are stored AND whatever their height (26.17), so a sparse volume's sums (the rest and settle
//           decisions read them) equal the dense run's bit for bit. param0 = the unit map's y count.
#define WC_BRICKS_BINDING 10
#include "water_core.glsl"
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) readonly buffer F     { float f[]; };
layout(std430, set = 0, binding = 1) readonly buffer FPrev { float fp[]; };
layout(std430, set = 0, binding = 2) readonly buffer U     { float u[]; };
layout(std430, set = 0, binding = 3) readonly buffer V     { float v[]; };
layout(std430, set = 0, binding = 4) readonly buffer W     { float w[]; };
layout(std430, set = 0, binding = 5)          buffer Part  { vec4 part[]; };   // per workgroup partials
layout(std430, set = 0, binding = 6)          buffer Out   { vec4 outv[]; };
layout(std430, set = 0, binding = 7)          buffer Part2 { vec4 part2[]; };
layout(std430, set = 0, binding = 8) readonly buffer Res   { float res[]; };      // RBGS residual per cell
layout(std430, set = 0, binding = 9) readonly buffer Drop  { float dropped[]; };  // residue dropped per column

shared vec4 sh[256];

void main() {
    const uint lid = gl_LocalInvocationID.x, gid = gl_GlobalInvocationID.x, wg = gl_WorkGroupID.x;
    if (pc.mode == 6) {   // uniform per dispatch: whole workgroups return before the barrier
        const int nuy = int(pc.param0);
        if (gid < uint(pc.bnx * nuy * pc.bnz)) {
            const int ux = int(gid) % pc.bnx, uy = (int(gid) / pc.bnx) % nuy, uz = int(gid) / (pc.bnx * nuy);
            const int qy = 2 * uy + (pc.oy & ~1);   // the unit's lowest cell in brick coords (oy and the unit grid agree mod 2)
            const int by = qy >> pc.bly;
            const int slot = by < pc.bny ? bricks[ux + pc.bnx * (by + pc.bny * uz)] : 0;
            part2[gid] = slot > 0 ? part[(uint(slot) << uint(pc.bly - 1)) + uint((qy & ((1 << pc.bly) - 1)) >> 1)] : vec4(0.0);
        }
        return;
    }
    vec4 mine = vec4(0.0);
    if (pc.mode == 0) {
        ivec3 c;
        if (threadSite(gid, 3, c)) {
            const float fc = f[gid];
            if (fc > 0.0) {
                const float ux = 0.5 * (u[uIdx(c.x, c.y, c.z)] + u[uIdx(c.x + 1, c.y, c.z)]);
                const float vy = 0.5 * (v[vIdx(c.x, c.y, c.z)] + v[vIdx(c.x, c.y + 1, c.z)]);
                const float wz = 0.5 * (w[wIdx(c.x, c.y, c.z)] + w[wIdx(c.x, c.y, c.z + 1)]);
                mine.x = 0.5 * fc * (ux * ux + vy * vy + wz * wz);
            }
            mine.y = abs(fc - fp[gid]) / cellVolume(c.x, c.y, c.z);   // 27.22f: a FRACTION of the cell (a tall cell's f is a volume of H cells)
            mine.z = fc;
        }
    } else if (pc.mode == 1) {
        ivec3 c;
        if (threadSite(gid, pc.iparam, c)) mine.w = abs(pc.iparam == 0 ? u[gid] : (pc.iparam == 1 ? v[gid] : w[gid]));
    } else if (pc.mode == 4) {
        ivec3 c;
        if (threadSite(gid, 3, c)) mine.w = res[gid];
    } else if (pc.mode == 5) {
        int x, z;
        if (threadColumn(gid, x, z)) mine.x = dropped[gid];
    } else if (pc.mode == 2) {
        const uint n = uint(pc.param0);
        if (gid < n) mine = part[gid];
    } else {
        const uint n = uint(pc.param0);
        if (gid < n) mine = part2[gid];
    }
    sh[lid] = mine;
    barrier();
    if (pc.mode == 0) {   // 26.17: each 128-thread half folds its own unit (the same tree for every brick height)
        const uint h = lid & 127u;
        for (uint s = 64u; s > 0u; s >>= 1u) {
            if (h < s) { sh[lid].x += sh[lid + s].x; sh[lid].y = max(sh[lid].y, sh[lid + s].y); sh[lid].z += sh[lid + s].z; sh[lid].w = max(sh[lid].w, sh[lid + s].w); }
            barrier();
        }
        if (h == 0u) part[2u * wg + (lid >> 7u)] = sh[lid];
        return;
    }
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (lid < s) { sh[lid].x += sh[lid + s].x; sh[lid].y = max(sh[lid].y, sh[lid + s].y); sh[lid].z += sh[lid + s].z; sh[lid].w = max(sh[lid].w, sh[lid + s].w); }
        barrier();
    }
    if (lid == 0u) {
        if (pc.mode <= 1 || pc.mode >= 4) part[wg] = sh[0];
        else if (pc.param1 == 1.0) outv[uint(pc.iparam)] = sh[0];
        else if (pc.mode == 2) part2[wg] = sh[0];
        else part[wg] = sh[0];
    }
}
