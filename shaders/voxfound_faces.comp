#version 450
// docs/VoxelFoundationPlan.md F2.1, §4.6 items 1-2 — the GPU face builder (FaceBuilderGpu).
//
// One invocation per slice ROW of one axis: (dir, slice s, row v). It walks u, forms maximal runs of
// faces of one material (hidden-face culling: a face exists where the voxel is solid and its neighbour
// across the face is air; outside the grid = air or no face, pc.dim.w), and emits a quad for every run
// that is the HEAD of a stack: no identical run (same start, width, material) in row v-1. The head then
// extends down while row v+h holds an identical run. Rows never talk to each other, so the result is a
// pure function of the voxels — the CPU reference is meshRuns (Mesher.cpp), equal as a set
// (VoxFoundFaceBuilderGpu, tests/integration).
//
// Output: the 8-byte PackedFace record (Mesher.h).
//   a: x 0-7 | y 8-15 | z 16-23 | axis 24-25 | dir>0 bit 26
//   b: du-1 0-7 | dv-1 8-15 | material 16-23
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer Vox { uint vox[]; };      // material bytes, 4 per word, VoxelGrid order
layout(std430, binding = 1) writeonly buffer Faces { uvec2 faces[]; };
layout(std430, binding = 2) buffer Counter { uint faceCount; uint skippedSpans; };
// UNIFORM-BLOCK SKIP (§4.6 item 1, F2.6): one word per 8^3 block, written by the block pass (job.x == 4) before
// the row passes. bit 0 = EMITS NOTHING (every voxel is air or a card material); bit 1 = HIDES EVERYTHING (no air).
// A face at p exists only if p is solid, not a card, and its neighbour q across the face is air, so a row may jump
// to the end of p's block when p's block emits nothing or q's block hides everything (q in the grid). Blocks at the
// grid's far edge are partial; their flags describe only their in-grid voxels.
layout(std430, binding = 3) buffer Blocks { uint blockFlags[]; };

layout(push_constant) uniform PC {
    ivec4 dim;     // xyz = grid size (each 1..256); w = outside: 0 air, 1 skip
    ivec4 job;     // x = axis (3 = the sprig pass, 4 = the block pass); y = invocations in this dispatch;
                   // z = face capacity; w = 1: rows use the uniform-block skip
    uvec4 cards0;  // CardSet bits 0-127: materials drawn as leaf cards (no faces; F2.3)
    uvec4 cards1;  // CardSet bits 128-255
    ivec4 origin;  // xyz = absolute cell of voxel (0,0,0); w = sprig keep threshold (24-bit hash)
} pc;

bool isCard(uint m) {
    const uint w = m >> 5u;
    const uint word = w < 4u ? pc.cards0[w] : pc.cards1[w - 4u];
    return ((word >> (m & 31u)) & 1u) != 0u;
}

// Today's canopy-thinning hash (ChunkRenderManager foliageCellHash01), 24 bits; == VoxFound::sprigHash24.
uint sprigHash24(ivec3 c) {
    uint h = uint(c.x) * 0x8DA6B343u ^ uint(c.y) * 0xD8163841u ^ uint(c.z) * 0xCB1AB31Fu;
    h ^= h >> 15; h *= 0x2C1B3C6Du; h ^= h >> 12; h *= 0x297A2D39u; h ^= h >> 15;
    return h & 0xFFFFFFu;
}

uint matAt(ivec3 p) {
    const int i = p.z + pc.dim.z * (p.y + pc.dim.y * p.x);
    return (vox[i >> 2] >> ((i & 3) * 8)) & 0xFFu;
}

bool inGrid(ivec3 p) {
    return all(greaterThanEqual(p, ivec3(0))) && all(lessThan(p, pc.dim.xyz));
}

int AX, UA, VA, DIR, S;

// Material of the exposed face at (u, v) of this slice, 0 = no face.
uint faceAt(int u, int v) {
    ivec3 p;
    p[AX] = S;
    p[UA] = u;
    p[VA] = v;
    const uint m = matAt(p);
    if (m == 0u || isCard(m)) return 0u;   // a card voxel draws no faces (it still hides others below)
    ivec3 q = p;
    q[AX] += DIR;
    if (!inGrid(q)) return pc.dim.w == 0 ? m : 0u;
    return matAt(q) == 0u ? m : 0u;
}

ivec3 blockDim() { return (pc.dim.xyz + 7) >> 3; }
uint blockAt(ivec3 p) {
    const ivec3 b = p >> 3, nb = blockDim();
    return blockFlags[b.z + nb.z * (b.y + nb.y * b.x)];
}

// True when no face can exist at any u' in [u, end of u's block) of this row (see Blocks above).
bool spanEmpty(int u, int v) {
    ivec3 p;
    p[AX] = S;
    p[UA] = u;
    p[VA] = v;
    if ((blockAt(p) & 1u) != 0u) return true;
    ivec3 q = p;
    q[AX] += DIR;
    return inGrid(q) && (blockAt(q) & 2u) != 0u;
}

// Does row r hold exactly the maximal run [u, u+w) of material m?
bool sameRun(int u, int w, int r, uint m, int nu) {
    if (u > 0 && faceAt(u - 1, r) == m) return false;
    if (u + w < nu && faceAt(u + w, r) == m) return false;
    for (int k = 0; k < w; ++k)
        if (faceAt(u + k, r) != m) return false;
    return true;
}

void main() {
    const uint id = gl_GlobalInvocationID.x;
    if (id >= uint(pc.job.y)) return;
    if (pc.job.x == 4) {
        // BLOCK pass: one invocation per 8^3 block, flags over its in-grid voxels.
        const ivec3 nb = blockDim();
        const int bi = int(id);
        const ivec3 b = ivec3(bi / (nb.y * nb.z), (bi / nb.z) % nb.y, bi % nb.z);
        const ivec3 lo = b * 8, hi = min(lo + 8, pc.dim.xyz);
        bool emitsNothing = true, hidesAll = true;
        for (int x = lo.x; x < hi.x; ++x)
            for (int y = lo.y; y < hi.y; ++y)
                for (int z = lo.z; z < hi.z; ++z) {
                    const uint m = matAt(ivec3(x, y, z));
                    if (m == 0u) hidesAll = false;
                    else if (!isCard(m)) emitsNothing = false;
                }
        blockFlags[bi] = (emitsNothing ? 1u : 0u) | (hidesAll ? 2u : 0u);
        return;
    }
    if (pc.job.x == 3) {
        // SPRIG pass (F2.3, VoxFound::foliageSprigs): one invocation per voxel. A card voxel with any face
        // neighbour air (outside the grid: air when dim.w == 0, never when skip) is a sprig, kept when today's
        // thinning hash on its absolute cell is below the threshold. Record: axis field 3.
        const int i = int(id);
        const ivec3 p = ivec3(i / (pc.dim.y * pc.dim.z), (i / pc.dim.z) % pc.dim.y, i % pc.dim.z);
        const uint m = matAt(p);
        if (m == 0u || !isCard(m)) return;
        if (sprigHash24(pc.origin.xyz + p) >= uint(pc.origin.w)) return;
        bool exposed = false;
        for (int a = 0; a < 3 && !exposed; ++a)
            for (int d = -1; d <= 1 && !exposed; d += 2) {
                ivec3 q = p;
                q[a] += d;
                exposed = inGrid(q) ? matAt(q) == 0u : pc.dim.w == 0;
            }
        if (!exposed) return;
        const uint slot = atomicAdd(faceCount, 1u);
        if (slot < uint(pc.job.z))
            faces[slot] = uvec2(uint(p.x) | (uint(p.y) << 8) | (uint(p.z) << 16) | (3u << 24), m << 16);
        return;
    }
    AX = pc.job.x;
    UA = (AX + 1) % 3;
    VA = (AX + 2) % 3;
    const int ns = pc.dim[AX], nu = pc.dim[UA], nv = pc.dim[VA];
    const uint perDir = uint(ns * nv);
    DIR = id < perDir ? -1 : 1;
    const uint rem = id % perDir;
    S = int(rem / uint(nv));
    const int v = int(rem % uint(nv));

    int u = 0;
    uint skipped = 0u;
    while (u < nu) {
        if (pc.job.w != 0 && spanEmpty(u, v)) {   // jump to the end of this block along u
            u = (u | 7) + 1;
            ++skipped;
            continue;
        }
        const uint m = faceAt(u, v);
        if (m == 0u) { ++u; continue; }
        int w = 1;
        while (u + w < nu && faceAt(u + w, v) == m) ++w;
        if (!(v > 0 && sameRun(u, w, v - 1, m, nu))) {
            int h = 1;
            while (v + h < nv && sameRun(u, w, v + h, m, nu)) ++h;
            ivec3 o;
            o[AX] = S;
            o[UA] = u;
            o[VA] = v;
            const uint slot = atomicAdd(faceCount, 1u);
            if (slot < uint(pc.job.z))
                faces[slot] = uvec2(uint(o.x) | (uint(o.y) << 8) | (uint(o.z) << 16) | (uint(AX) << 24) |
                                        (DIR > 0 ? (1u << 26) : 0u),
                                    uint(w - 1) | (uint(h - 1) << 8) | (m << 16));
        }
        u += w;
    }
    if (skipped != 0u) atomicAdd(skippedSpans, skipped);
}
