#version 450
#extension GL_GOOGLE_include_directive : require
#include "solver_types.glsl"

layout(local_size_x = WORKGROUP_SOLVER) in;

layout(std430, set=0, binding=0) readonly buffer ConstraintBuffer    { GPUConstraint constraints[]; };
layout(std430, set=0, binding=1) readonly buffer SolverStateBuffer   { uint solverState[]; };
layout(std430, set=0, binding=2) buffer BodyConstraintCount          { uint bodyConstraintCount[]; };

layout(push_constant) uniform PC { PHX_PC_CONSTRAINTS } pc;  // shaders/solver_shared.h

void main() {
    uint ci = gl_GlobalInvocationID.x;
    uint constraintCount = solverState[SS_CONSTRAINT_COUNT];
    if (ci >= constraintCount || ci >= pc.maxConstraints) return;

    GPUConstraint c = constraints[ci];
    atomicAdd(bodyConstraintCount[c.bodyA], 1u);
    // A mover body (Phase 2) is never solved: like a static B it gets no adjacency entry
    // (and its index lies beyond the per-body arrays, which cover only the particle range).
    if (c.bodyB != SOLVER_STATIC && !isKinematicBody(c.bodyB))
        atomicAdd(bodyConstraintCount[c.bodyB], 1u);
}
