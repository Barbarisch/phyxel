#version 450
#extension GL_GOOGLE_include_directive : require
#include "particle_types.glsl"
#include "solver_types.glsl"

layout(local_size_x = WORKGROUP_SOLVER) in;

layout(std430, set=0, binding=0) buffer SolverBodyBuffer        { SolverBody  bodies[]; };
layout(std430, set=0, binding=1) readonly buffer MaterialBuffer { MaterialPhysics materials[]; };
layout(std430, set=0, binding=2) readonly buffer ParticleBuffer { GpuParticle particles[]; };
// Phase 6c water: this frame slot's tile directory (WATER_DIR_CHUNKS^2 entries, a tile index or
// WATER_TILE_NONE) and tile pool (WATER_TILE_CELLS^2 cells per tile: x = surface Y bits, y = flow
// xz as half2). Everything else (no tile) is the background: the implicit sea, or dry.
layout(std430, set=0, binding=3) readonly buffer WaterDirBuffer  { uint waterDir[]; };
layout(std430, set=0, binding=4) readonly buffer WaterTileBuffer { uvec2 waterCells[]; };


// Movers (the player, scripted boxes, later every character) are AVBD bodies since Phase 2:
// narrowphase contacts against kinematic bodies push debris, and its impact wake wakes it.
// The old per-limb shove that lived here (D7: push-out + velocity copy + a +0.5 m/s pop,
// flinging bodies to ~6 m/s) is deleted (DebrisInteractionPlan Phase 2).

layout(push_constant) uniform PC { PHX_PC_INTEGRATE } pc;  // shaders/solver_shared.h

// Top water surface Y over world column (x, z) and its flow; WATER_DRY when dry.
float waterSurface(vec3 p, out vec2 flow) {
    flow = vec2(0.0);
    const int x = int(floor(p.x)), z = int(floor(p.z));
    const int d = phxWaterDirIndex(x, z, pc.water.x, pc.water.y);
    const bool sea = (pc.water.z & 1) != 0;
    const float seaY = intBitsToFloat(pc.water.w);
    if (d < 0) return sea ? seaY : WATER_DRY;          // outside the window: the background
    const uint t = waterDir[d];
    if (t == WATER_TILE_NONE) return sea ? seaY : WATER_DRY;
    const uvec2 c = waterCells[t * uint(WATER_TILE_CELLS * WATER_TILE_CELLS) + uint(phxWaterCellIndex(x, z))];
    flow = unpackHalf2x16(c.y);
    return uintBitsToFloat(c.x);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;

    SolverBody b = bodies[i];

    if ((b.flags & PARTICLE_ACTIVE) == 0u || b.invMass == 0.0) {
        // Static/inactive: save initial, stay in place
        b.initial      = b.pos;
        b.initialQuat  = b.quat;
        b.inertial     = b.pos;
        b.inertialQuat = b.quat;
        b.cumAng       = vec3(0.0);
        bodies[i] = b;
        return;
    }

    GpuParticle     p   = particles[b.particleIdx];
    MaterialPhysics mat = materials[p.materialIndex & MATERIAL_MASK];

    // Save state before any forces (these are the "initial" AVBD reference values)
    b.prevVel     = b.vel;
    b.initial     = b.pos;
    b.initialQuat = b.quat;

    // ---- Adaptive accelWeight (Shallot-style; AVBD paper §4) ----------------
    // At rest, predicting body.pos with full gravity moves it DOWN by ~g*dt² each
    // frame, forcing narrowphase to re-emit fresh penetration → tug-of-war between
    // gravity step and solver pushback → vibration / popcorn.
    //
    // Shallot uses accelWeight = clamp(actual_accel.y * sign(g) / |g|, 0, 1):
    // 0 at rest (constraints cancel gravity), 1 in free fall. This requires prevVel
    // persisted across frames; our sync_in resets prevVel each frame, so we use a
    // velocity-magnitude heuristic instead — same outcome for the resting case.
    //   speed² < REST_SQ  → accelWeight ≈ 0 → body.pos NOT pushed by gravity
    //   speed² > MOVE_SQ  → accelWeight = 1 → full free-fall prediction
    float speedSq = dot(b.vel, b.vel);
    const float REST_SQ = 0.01;     // (0.1 m/s)²
    const float MOVE_SQ = 1.0;      // (1.0 m/s)²
    float accelWeight = clamp((speedSq - REST_SQ) / (MOVE_SQ - REST_SQ), 0.0, 1.0);

    // Apply external forces: gravity + damping
    b.vel.y   += pc.gravity * pc.dt;
    b.vel     *= mat.linearDamp  * GAMMA;
    b.angVel  *= mat.angularDamp * GAMMA;

    // ---- Water (Phase 6c): the same law VoxelDynamicsWorld applies to CPU bodies
    // (solver_shared.h). f = submerged fraction of the body's vertical extent (bounding radius),
    // b = the material's buoyancy ratio. buoyAccY joins gravity in the at-rest back-off below, so a
    // floater at equilibrium does not start each solve displaced upward.
    float buoyAccY = 0.0;
    if ((pc.flags & SOLVER_FLAG_WATER) != 0u) {
        vec2 flow;
        const float surf = waterSurface(b.pos, flow);
        const float r = max(b.radius, 1e-3);
        const float f = clamp((surf - (b.pos.y - r)) / (2.0 * r), 0.0, 1.0);
        if (f > 0.0) {
            buoyAccY = -pc.gravity * f * mat.buoyancy;
            b.vel.y  += buoyAccY * pc.dt;
            b.vel    *= pow(1.0 - WATER_LINEAR_DRAG,  pc.dt * f);
            b.angVel *= pow(1.0 - WATER_ANGULAR_DRAG, pc.dt * f);
            const float k = min(1.0, WATER_CURRENT_COUPLE * f * pc.dt);
            b.vel.xz += (flow - b.vel.xz) * k;
        }
    }

    // Inertial (unconstrained) prediction: where the body goes with no contacts.
    // Used as the energy minimum in primal/dual — solver pulls body toward it.
    b.inertial     = b.pos + b.vel * pc.dt;
    b.inertialQuat = quatIntegrate(b.quat, b.angVel * pc.dt);

    // Adaptive starting iterate for body.pos. After applying gravity above we have
    //   b.vel * dt = b.vel_old * dt + g*dt²        (gravity already baked in)
    // Subtracting (1-accelWeight)*g*dt² removes the gravity component for at-rest
    // bodies, so narrowphase sees the same position as last frame → no fresh
    // penetration → λ stays steady. In free-fall (accelWeight=1) this collapses
    // to the full inertial prediction.
    float gravBackoff = (1.0 - accelWeight) * (pc.gravity + buoyAccY) * pc.dt * pc.dt;
    b.pos  = b.inertial - vec3(0.0, gravBackoff, 0.0);
    b.quat = b.inertialQuat;

    // Seed cumAng with the angular displacement accumulated during force integration
    b.cumAng = angDispFromInitial(b.inertialQuat, b.initialQuat);

    // startAtRest (three-avbd docs/FINDINGS.md Stage 8m): the guess above still extrapolates
    // last tick's UNCONVERGED velocity, which in a resting stack "turns jitter into a push
    // down into the supports" — each tick's leftover motion becomes next tick's overlap,
    // whose correction becomes velocity again. A slow body starts the solve from where it
    // IS (x⁻); `inertial` is untouched, so gravity still acts through the energy minimum and
    // an unsupported body still falls. Faster bodies keep the extrapolated guess (starting
    // everything at x⁻ damps real sliding — three-avbd measured 2.26 m vs Coulomb 3.16 m).
    if ((pc.flags & SOLVER_FLAG_START_AT_REST) != 0u) {
        float restSpeed = length(b.prevVel) + length(b.angVel) * b.radius;
        if (restSpeed < 0.1) {
            b.pos    = b.initial;
            b.quat   = b.initialQuat;
            b.cumAng = vec3(0.0);
        }
    }

    bodies[i] = b;
}
