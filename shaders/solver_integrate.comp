#version 450
#extension GL_GOOGLE_include_directive : require
#include "particle_types.glsl"
#include "solver_types.glsl"

layout(local_size_x = WORKGROUP_SOLVER) in;

layout(std430, set=0, binding=0) buffer SolverBodyBuffer        { SolverBody  bodies[]; };
layout(std430, set=0, binding=1) readonly buffer MaterialBuffer { MaterialPhysics materials[]; };
layout(std430, set=0, binding=2) readonly buffer ParticleBuffer { GpuParticle particles[]; };
// Phase 6c water: this frame slot's tile directory (WATER_DIR_CHUNKS^2 entries, a tile index or
// WATER_TILE_NONE) and tile pool (WATER_TILE_CELLS^2 cells per tile: x = surface Y bits, y = flow
// xz as half2). Everything else (no tile) is the background: the implicit sea, or dry.
layout(std430, set=0, binding=3) readonly buffer WaterDirBuffer  { uint waterDir[]; };
layout(std430, set=0, binding=4) readonly buffer WaterTileBuffer { uint waterCells[]; };   // WATER_CELL_WORDS per cell (37)
// WaterCore E2: the water's share of each wet body's drag + current, appended per tick (host-visible,
// per frame slot, read back after its fence - the event-buffer pattern).
struct WaterExchange { PHX_WATER_EXCHANGE };
layout(std430, set=0, binding=5) buffer WaterExchangeBuffer { uint exchangeCount; uint xPad0, xPad1, xPad2; WaterExchange exchanges[]; };
// WaterCore 20 (moving solids): the water-volume boxes (written by the host) and the wet-body records
struct WetBody { PHX_WET_BODY };
layout(std430, set=0, binding=6) buffer WetBodyBuffer { uint wetCount; uint pressPushed, pressFellBack, pressNoWindow; uint boxCount; uint bPad0, bPad1, bPad2;
                                                        vec4 boxMin[MAX_WATER_BOXES]; vec4 boxMax[MAX_WATER_BOXES]; WetBody wetBodies[]; };
// WaterCore 31 (M4): the pressure windows the water volumes' calls wrote this frame (wc_body_pressure.comp; solver_shared.h)
struct PressureWindow { PHX_PRESSURE_WINDOW };
layout(std430, set=0, binding=7) readonly buffer PressureWindowBuffer { PressureWindow pwins[]; };
layout(std430, set=0, binding=8) readonly buffer PressureDataBuffer   { float pwData[]; };
layout(std430, set=0, binding=9) readonly buffer PressureOfBuffer     { uint pwOf[]; };   // per solver slot: window index + 1 (0 none)

// The window the force function reads (water_body_force.glsl's wbfP): set per body before wbfAccel. 31.7: a 2-D map of the LEVEL of
// the water round the body (wc_body_pressure.comp); the pressure at x is that level's hydrostatic pressure, g (level - y)
ivec3 gPwOrigin; ivec3 gPwDims; uint gPwOff; float gPwH; float gPwG;
vec2 wbfP(vec3 x) {
    const ivec2 c = ivec2(floor(x.xz / gPwH)) - gPwOrigin.xz;
    if (any(lessThan(c, ivec2(0))) || any(greaterThanEqual(c, gPwDims.xz))) return vec2(uintBitsToFloat(0x7fc00000u), x.y);  // left its window: unknown
    const float lv = pwData[gPwOff + uint(c.x + gPwDims.x * c.y)];
    if (isnan(lv)) return vec2(0.0, x.y);   // a dry column (a shore): air
    return vec2(gPwG * (lv - x.y), x.y);
}
#include "water_body_force.glsl"


// Movers (the player, scripted boxes, later every character) are AVBD bodies since Phase 2:
// narrowphase contacts against kinematic bodies push debris, and its impact wake wakes it.
// The old per-limb shove that lived here (D7: push-out + velocity copy + a +0.5 m/s pop,
// flinging bodies to ~6 m/s) is deleted (DebrisInteractionPlan Phase 2).

layout(push_constant) uniform PC { PHX_PC_INTEGRATE } pc;  // shaders/solver_shared.h

// The water surface Y a body whose top is at bodyTop reads over world column (x, z), and its flow; WATER_DRY when dry.
// 37 (A2e): the run the body is IN (phxWaterRunSurface) - not the column's top run, which put a body in a dry cave under a
// pond under the pond's level.
float waterSurface(vec3 p, float bodyTop, out vec2 flow) {
    flow = vec2(0.0);
    const int x = int(floor(p.x)), z = int(floor(p.z));
    const int d = phxWaterDirIndex(x, z, pc.water.x, pc.water.y);
    const bool sea = (pc.water.z & 1) != 0;
    const float seaY = intBitsToFloat(pc.water.w);
    if (d < 0) return sea ? seaY : WATER_DRY;          // outside the window: the background
    const uint t = waterDir[d];
    if (t == WATER_TILE_NONE) return sea ? seaY : WATER_DRY;
    const uint c = (t * uint(WATER_TILE_CELLS * WATER_TILE_CELLS) + uint(phxWaterCellIndex(x, z))) * uint(WATER_CELL_WORDS);
    const float s = phxWaterRunSurface(uintBitsToFloat(waterCells[c]), uintBitsToFloat(waterCells[c + 1u]),
                                       uintBitsToFloat(waterCells[c + 3u]), uintBitsToFloat(waterCells[c + 4u]), bodyTop);
    if (s == uintBitsToFloat(waterCells[c]) && s > WATER_DRY) flow = unpackHalf2x16(waterCells[c + 2u]);   // the top run's flow only
    return s;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;

    SolverBody b = bodies[i];

    if ((b.flags & PARTICLE_ACTIVE) == 0u || b.invMass == 0.0) {
        // Static/inactive: save initial, stay in place
        b.initial      = b.pos;
        b.initialQuat  = b.quat;
        b.inertial     = b.pos;
        b.inertialQuat = b.quat;
        b.cumAng       = vec3(0.0);
        bodies[i] = b;
        return;
    }

    GpuParticle     p   = particles[b.particleIdx];
    MaterialPhysics mat = materials[p.materialIndex & MATERIAL_MASK];

    bool inWaterBox = false;   // WaterCore 31: a pressure window can only exist for a body inside a volume's box
    uint wetSlot = 0xFFFFFFFFu;   // 31: this tick's record, so the push the water gave can be written into it (halfExt.w, vel.w)
    // WaterCore 20: a body inside a water volume's box reports its box - the volume treats it as a moving
    // solid (docs/WaterCore.md 20.4). Before any force: the pose the tick starts from.
    {
        const uint nb = min(boxCount, MAX_WATER_BOXES);
        const vec3 r3 = vec3(max(b.radius, 1e-3));
        for (uint k = 0u; k < nb; ++k) {
            if (all(greaterThanEqual(b.pos + r3, boxMin[k].xyz)) && all(lessThanEqual(b.pos - r3, boxMax[k].xyz))) {
                inWaterBox = true;
                const uint s = atomicAdd(wetCount, 1u);
                if (s < MAX_WET_BODIES) {
                    wetSlot = s;
                    wetBodies[s].posSlot = vec4(b.pos, uintBitsToFloat(i));
                    wetBodies[s].halfExt = vec4(b.halfExt, 0.0);
                    wetBodies[s].vel     = vec4(b.vel, 0.0);
                }
                break;
            }
        }
    }

    // Save state before any forces (these are the "initial" AVBD reference values)
    b.prevVel     = b.vel;
    b.initial     = b.pos;
    b.initialQuat = b.quat;

    // ---- Adaptive accelWeight (Shallot-style; AVBD paper §4) ----------------
    // At rest, predicting body.pos with full gravity moves it DOWN by ~g*dt² each
    // frame, forcing narrowphase to re-emit fresh penetration → tug-of-war between
    // gravity step and solver pushback → vibration / popcorn.
    //
    // Shallot uses accelWeight = clamp(actual_accel.y * sign(g) / |g|, 0, 1):
    // 0 at rest (constraints cancel gravity), 1 in free fall. This requires prevVel
    // persisted across frames; our sync_in resets prevVel each frame, so we use a
    // velocity-magnitude heuristic instead — same outcome for the resting case.
    //   speed² < REST_SQ  → accelWeight ≈ 0 → body.pos NOT pushed by gravity
    //   speed² > MOVE_SQ  → accelWeight = 1 → full free-fall prediction
    float speedSq = dot(b.vel, b.vel);
    const float REST_SQ = 0.01;     // (0.1 m/s)²
    const float MOVE_SQ = 1.0;      // (1.0 m/s)²
    float accelWeight = clamp((speedSq - REST_SQ) / (MOVE_SQ - REST_SQ), 0.0, 1.0);

    // Apply external forces: gravity + damping. 26.25: in water the material damping (air resistance) acts on the velocity
    // RELATIVE TO THE WATER (w = the current while the body touches water - the WHOLE damping: a submerged share left half the
    // brake on a half-sunk float, and air drag on a slow float is nothing beside the water's laws): against the ground every float riding a current was
    // braked below it, and the water exchange below handed that brake back to the pond water as momentum taken from it - each
    // float slowed its own patch of water and read that as the current (0.47 of the creek; 1.05 with the exchange off).
    // Dry (f = 0): w = 0, the old law exactly.
    vec3 dampRef = vec3(0.0);
    if ((pc.flags & SOLVER_FLAG_WATER) != 0u) {
        vec2 flowD;
        const float rD = max(b.radius, 1e-3);
        const float surfD = waterSurface(b.pos, b.pos.y + rD, flowD);
        const float fD = clamp((surfD - (b.pos.y - rD)) / (2.0 * rD), 0.0, 1.0);
        if (fD > 0.0) dampRef = vec3(flowD.x, 0.0, flowD.y);
    }
    b.vel.y   += pc.gravity * pc.dt;
    b.vel      = dampRef + (b.vel - dampRef) * (mat.linearDamp * GAMMA);
    b.angVel  *= mat.angularDamp * GAMMA;

    // ---- Water (Phase 6c): the same law VoxelDynamicsWorld applies to CPU bodies
    // (solver_shared.h). f = submerged fraction of the body's vertical extent (bounding radius),
    // b = the material's buoyancy ratio. buoyAccY joins gravity in the at-rest back-off below, so a
    // floater at equilibrium does not start each solve displaced upward.
    float buoyAccY = 0.0;
    if ((pc.flags & SOLVER_FLAG_WATER) != 0u) {
        vec2 flow;
        const float r = max(b.radius, 1e-3);
        const float surf = waterSurface(b.pos, b.pos.y + r, flow);
        float f = clamp((surf - (b.pos.y - r)) / (2.0 * r), 0.0, 1.0);
        // WaterCore 31 (M4): inside an awake GPU volume the push is the PRESSURE over the body's faces (water_body_force.glsl), read
        // from this frame's window at the body's own pose: water over a body presses it down, air under it holds nothing up (31.1:
        // a rising block's own water cap read as its waterline lifted it 3 m, every 1.3 s). No fresh window, or a sample outside it,
        // keeps the table law below (counted). 33 (A2g): a body with NO window is never rasterized (the editor filters the moving
        // solids by the windows granted), so its column holds no cap of its own; a stale window (older than PRESSURE_WINDOW_MAX_AGE)
        // means the water has not stepped, and an unstepped volume pumps nothing.
        bool pressed = false;
        b.flags &= ~PARTICLE_WATER_UNSETTLED;
        if (pc.pressure.y != 0u && inWaterBox) {
            const uint wi = pwOf[i];
            bool fresh = false;
            if (wi > 0u && wi <= MAX_PRESSURE_WINDOWS) {
                const PressureWindow w = pwins[wi - 1u];
                fresh = uint(w.origin.w) == i && pc.pressure.x - floatBitsToUint(w.meta.y) <= PRESSURE_WINDOW_MAX_AGE;
                if (fresh) {
                    gPwOrigin = w.origin.xyz; gPwDims = w.dims.xyz; gPwOff = uint(w.dims.w); gPwH = w.meta.x; gPwG = -pc.gravity;
                    const vec4 fa = wbfAccel(b.pos, max(b.halfExt, vec3(1e-4)), quatRotate(b.quat, vec3(1, 0, 0)), quatRotate(b.quat, vec3(0, 1, 0)),
                                             quatRotate(b.quat, vec3(0, 0, 1)), gPwH, -pc.gravity,
                                             isnan(w.meta.z) ? 3.0e38 : w.meta.z);   // 31.7: the ring's highest surface
                    if (wetSlot < MAX_WET_BODIES) { wetBodies[wetSlot].halfExt.w = fa.y * mat.buoyancy; wetBodies[wetSlot].vel.w = isnan(w.meta.z) ? -1.0e30 : w.meta.z; }
                    if (fa.w >= 0.0) {
                        pressed = true; f = fa.w;
                        const vec3 acc = fa.xyz * mat.buoyancy;
                        buoyAccY = acc.y;
                        b.vel += acc * pc.dt;
                        // 31.8: a FLOATER off balance does not sleep (a sinker on the floor is always "off balance" - the floor holds the rest)
                        if (mat.buoyancy > 1.0 && abs(acc.y + pc.gravity) > WATER_UNSETTLED_ACC) b.flags |= PARTICLE_WATER_UNSETTLED;
                        atomicAdd(pressPushed, 1u);
                    } else {
                        // 33 (A2g): the fallback never reads the body's own cap - the waterline is at most the ring's surface
                        f = clamp((wbfFallbackSurface(surf, w.meta.z) - (b.pos.y - r)) / (2.0 * r), 0.0, 1.0);
                        atomicAdd(pressFellBack, 1u);
                    }
                }
            }
            if (!fresh) atomicAdd(pressNoWindow, 1u);
        }
        if (!pressed && f > 0.0) {   // the table law (6c): buoyancy from the column's surface
            buoyAccY = -pc.gravity * f * mat.buoyancy;
            b.vel.y  += buoyAccY * pc.dt;
        }
        if (f > 0.0) {
            const vec3 vBeforeWater = b.vel;   // E2: the exchange is drag + current only (buoyancy is static pressure)
            // 24.9: the waterline's radiation damping only - on the velocity RELATIVE TO THE WATER (25.28: on the ground velocity
            // it braked every float riding a current - steady drift 3 / (3 + 2.3) = 0.57 of the current, measured 0.24 of 0.50 m/s)
            if (f < 1.0) { const vec3 wv = vec3(flow.x, 0.0, flow.y); b.vel = wv + (b.vel - wv) * pow(1.0 - WATER_LINEAR_DRAG, pc.dt * f); }
            {   // 24.9: form drag on the velocity RELATIVE TO THE WATER, k = Cd (A / V) b f / 2 (its box, unrotated)
                const vec3 water = vec3(flow.x, 0.0, flow.y);
                const vec3 rel = b.vel - water;
                const float sp = length(rel);
                if (sp > 1e-4) {
                    const vec3 u = abs(rel) / sp;
                    const vec3 he = max(b.halfExt, vec3(1e-4));
                    const float areaOverVol = 4.0 * (he.y * he.z * u.x + he.x * he.z * u.y + he.x * he.y * u.z) / (8.0 * he.x * he.y * he.z);
                    const float k = WATER_FORM_CD * areaOverVol * mat.buoyancy * f * 0.5;
                    b.vel = water + rel / (1.0 + k * sp * pc.dt);
                }
            }
            b.angVel *= pow(1.0 - WATER_ANGULAR_DRAG, pc.dt * f);
            const float k = min(1.0, WATER_CURRENT_COUPLE * f * pc.dt);
            b.vel.xz += (flow - b.vel.xz) * k;
            const vec3 dv = b.vel - vBeforeWater;
            if (dot(dv, dv) > WATER_EXCHANGE_MIN_DV * WATER_EXCHANGE_MIN_DV) {
                const uint slot = atomicAdd(exchangeCount, 1u);
                if (slot < MAX_WATER_EXCHANGE) {
                    const float vol = 8.0 * b.halfExt.x * b.halfExt.y * b.halfExt.z;
                    exchanges[slot].posMass  = vec4(b.pos, vol / max(mat.buoyancy, 0.05));
                    exchanges[slot].dvRadius = vec4(dv, r);
                }
            }
        }
    }

    // Inertial (unconstrained) prediction: where the body goes with no contacts.
    // Used as the energy minimum in primal/dual — solver pulls body toward it.
    b.inertial     = b.pos + b.vel * pc.dt;
    b.inertialQuat = quatIntegrate(b.quat, b.angVel * pc.dt);

    // Adaptive starting iterate for body.pos. After applying gravity above we have
    //   b.vel * dt = b.vel_old * dt + g*dt²        (gravity already baked in)
    // Subtracting (1-accelWeight)*g*dt² removes the gravity component for at-rest
    // bodies, so narrowphase sees the same position as last frame → no fresh
    // penetration → λ stays steady. In free-fall (accelWeight=1) this collapses
    // to the full inertial prediction.
    float gravBackoff = (1.0 - accelWeight) * (pc.gravity + buoyAccY) * pc.dt * pc.dt;
    b.pos  = b.inertial - vec3(0.0, gravBackoff, 0.0);
    b.quat = b.inertialQuat;

    // Seed cumAng with the angular displacement accumulated during force integration
    b.cumAng = angDispFromInitial(b.inertialQuat, b.initialQuat);

    // startAtRest (three-avbd docs/FINDINGS.md Stage 8m): the guess above still extrapolates
    // last tick's UNCONVERGED velocity, which in a resting stack "turns jitter into a push
    // down into the supports" — each tick's leftover motion becomes next tick's overlap,
    // whose correction becomes velocity again. A slow body starts the solve from where it
    // IS (x⁻); `inertial` is untouched, so gravity still acts through the energy minimum and
    // an unsupported body still falls. Faster bodies keep the extrapolated guess (starting
    // everything at x⁻ damps real sliding — three-avbd measured 2.26 m vs Coulomb 3.16 m).
    if ((pc.flags & SOLVER_FLAG_START_AT_REST) != 0u) {
        float restSpeed = length(b.prevVel) + length(b.angVel) * b.radius;
        if (restSpeed < 0.1) {
            b.pos    = b.initial;
            b.quat   = b.initialQuat;
            b.cumAng = vec3(0.0);
        }
    }

    bodies[i] = b;
}
