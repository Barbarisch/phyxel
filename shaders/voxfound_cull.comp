#version 450
//
// voxfound_cull.comp — docs/VoxelFoundationPlan.md F2.11 (§4.6 item 5 + item 3's per-block part): the GPU
// draw-building pass of the 1/8 m store. One invocation per face cluster (Mesher.h clusterFaces); each cluster owns
// one VkDrawIndexedIndirectCommand, and this pass writes only its instanceCount: the cluster's face count when its
// chunk is visible (the CPU's per-chunk distance + frustum + occlusion decision, F2.9/F2.10) and its box is inside
// the camera frustum, else 0. Same p-vertex test as the CPU reference VoxFound::boxInFrustum.
// Boxes and planes are relative to the region's anchor (metres), so the numbers stay small (exact-ish floats).

layout(local_size_x = 64) in;

struct Cluster {
    vec4 lo;   // xyz box min; w = chunk index (uint bits)
    vec4 hi;   // xyz box max; w = face count (uint bits)
};
layout(std430, binding = 0) readonly buffer Clusters { Cluster clusters[]; };
layout(std430, binding = 1) readonly buffer ChunkVisible { uint chunkVisible[]; };
layout(std430, binding = 2) buffer Commands { uint commands[]; };   // 5 words per command

layout(push_constant) uniform PC {
    vec4 planes[6];   // inside where dot(xyz, p) + w >= 0
    vec4 lodCam;      // F2.14: xyz camera (box frame), w = c (Mesher.h lodScaleFromCode)
    uint count;
    uint lod;         // F2.14: bit 8 = level test on, bits 0-7 = maxLevel
} pc;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    const Cluster c = clusters[i];
    const uint bits = floatBitsToUint(c.lo.w);   // chunk index 0-23 | level 24-27 (F2.14)
    bool vis = chunkVisible[bits & 0xFFFFFFu] != 0u;
    // F2.14: a cluster of level k is drawn only where a fragment in its box may keep level k (Mesher.h
    // lodLevelsForBox: nearest point - slack with the lowest Bayer value, farthest corner + slack with the highest);
    // without the level test, level 0 only.
    const int level = int((bits >> 24u) & 0xFu);
    if ((pc.lod & 0x100u) == 0u) {
        vis = vis && level == 0;
    } else if (vis) {
        const int maxLevel = int(pc.lod & 0xFFu);
        const vec3 cam = pc.lodCam.xyz;
        const vec3 nearest = clamp(cam, c.lo.xyz, c.hi.xyz);
        const vec3 farthest = mix(c.hi.xyz, c.lo.xyz, greaterThan(abs(cam - c.lo.xyz), abs(cam - c.hi.xyz)));
        const float lNear = log2(max(length(nearest - cam), 1e-3)) + pc.lodCam.w;
        const float lFar = log2(max(length(farthest - cam), 1e-3)) + pc.lodCam.w;
        const int lo = clamp(int(floor(lNear - 0.25 + 0.5 * (0.5 / 16.0 - 0.5))), 0, maxLevel);
        const int hi = clamp(int(floor(lFar + 0.25 + 0.5 * (15.5 / 16.0 - 0.5))), 0, maxLevel);
        vis = level >= lo && level <= hi;
    }
    for (int k = 0; k < 6 && vis; ++k) {
        const vec3 n = pc.planes[k].xyz;
        const vec3 p = vec3(n.x >= 0.0 ? c.hi.x : c.lo.x, n.y >= 0.0 ? c.hi.y : c.lo.y, n.z >= 0.0 ? c.hi.z : c.lo.z);
        if (dot(n, p) + pc.planes[k].w < 0.0) vis = false;
    }
    commands[i * 5u + 1u] = vis ? floatBitsToUint(c.hi.w) : 0u;
}
